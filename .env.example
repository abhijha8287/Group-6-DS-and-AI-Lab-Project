# Future LiveKit audio transport; not wired into the text pipeline.
# LiveKit Cloud/Inference is billed separately from OpenAI; approved path is local LiveKit.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LLM provider for the M3 pipeline (see milestones/M3_architecture/report.md, Section 3.3)
# Adapter formats: openai | anthropic | groq | ollama
# Paid execution: direct OpenAI text only, with an approved experiments/cost_ledger.json
# batch and CLI --budget-batch ID. All paid batches start unapproved; see M4 model_and_spending_plan.md.
# Local Ollama is available for development when installed; other remote providers/audio are blocked.
LLM_PROVIDER=
LLM_MODEL=
# Optional per-role overrides, e.g. a stronger judge than the agent:
# AGENT_PROVIDER= / AGENT_MODEL=   SIMULATOR_PROVIDER= / SIMULATOR_MODEL=   JUDGE_PROVIDER= / JUDGE_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Optional future STT/TTS; Deepgram/Cartesia are deferred and billed separately.
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# Future telephony (not implemented); separate carrier/number fees. No real outbound calls.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# CRM sandbox database
DATABASE_URL=postgresql://user:password@localhost:5432/crm_sandbox

# Outbound safety (demo only calls numbers on this allow-list)
OUTBOUND_TEST_ALLOWLIST_PATH=configs/outbound_test_allowlist.yaml
