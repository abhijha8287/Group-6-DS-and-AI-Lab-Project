# LiveKit (audio transport / rooms)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LLM provider(s)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Speech-to-text / text-to-speech
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# Telephony (SIP trunk / phone numbers) - used from M3 onwards
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# CRM sandbox database
DATABASE_URL=postgresql://user:password@localhost:5432/crm_sandbox

# Outbound safety (demo only calls numbers on this allow-list)
OUTBOUND_TEST_ALLOWLIST_PATH=configs/outbound_test_allowlist.yaml
